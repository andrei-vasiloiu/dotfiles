#!/usr/bin/env bash
set -Eeuo pipefail

choice="$(
  printf '%s\n' \
    "Lock" \
    "Suspend" \
    "Hibernate" \
    "Log out" \
    "Reboot" \
    "Shut down" |
    fuzzel --dmenu --prompt="Power › "
)"

case "$choice" in
  "Lock")
    swaylock
    ;;
  "Suspend")
    systemctl suspend
    ;;
  "Hibernate")
    systemctl hibernate
    ;;
  "Log out")
    swaymsg exit
    ;;
  "Reboot")
    systemctl reboot
    ;;
  "Shut down")
    systemctl poweroff
    ;;
esac
