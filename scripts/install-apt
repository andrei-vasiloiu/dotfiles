#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

source "$repo_root/scripts/lib/logging.sh"
source "$repo_root/scripts/lib/platform.sh"

require_debian

manifests=(
  "$repo_root/packages/common.txt"
)

if is_wsl; then
  manifests+=("$repo_root/packages/wsl.txt")
  log_info "WSL package manifest enabled"
fi

mapfile -t packages < <(
  grep -hEv '^[[:space:]]*(#|$)' "${manifests[@]}" |
    sort -u
)

log_info "Installing ${#packages[@]} APT packages"

sudo apt-get update
sudo apt-get install -y "${packages[@]}"
