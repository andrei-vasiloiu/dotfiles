#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

source "$repo_root/scripts/lib/logging.sh"
source "$repo_root/scripts/versions.env"

roslyn_version="$ROSLYN_VERSION"

if ! command -v dotnet >/dev/null 2>&1; then
  log_info "Installing Microsoft .NET SDK 10"

  tmp_package="/tmp/packages-microsoft-prod.deb"

  wget \
    https://packages.microsoft.com/config/debian/13/packages-microsoft-prod.deb \
    -O "$tmp_package"

  sudo dpkg -i "$tmp_package"
  sudo apt-get update
  sudo apt-get install -y dotnet-sdk-10.0
else
  log_info ".NET already installed: $(dotnet --version)"
fi

installed="$(
  dotnet tool list --global |
    awk '$1 == "roslyn-language-server" { print $2 }'
)"

if [[ "$installed" != "$roslyn_version" ]]; then
  if [[ -n "$installed" ]]; then
    log_info "Updating Roslyn language server to ${roslyn_version}"
    dotnet tool update --global \
      roslyn-language-server \
      --version "$roslyn_version"
  else
    log_info "Installing Roslyn language server ${roslyn_version}"
    dotnet tool install --global \
      roslyn-language-server \
      --version "$roslyn_version"
  fi
else
  log_info "Roslyn already installed: ${installed}"
fi

log_info "dotnet: $(dotnet --version)"
log_info "roslyn-language-server: ${roslyn_version}"
