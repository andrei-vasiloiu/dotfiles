#!/usr/bin/env bash
set -Eeuo pipefail

if ! command -v dotnet >/dev/null 2>&1; then
  tmp_package="/tmp/packages-microsoft-prod.deb"

  wget \
    https://packages.microsoft.com/config/debian/13/packages-microsoft-prod.deb \
    -O "$tmp_package"

  sudo dpkg -i "$tmp_package"
  sudo apt-get update
  sudo apt-get install -y dotnet-sdk-10.0
fi

if ! command -v roslyn-language-server >/dev/null 2>&1; then
  dotnet tool install --global roslyn-language-server --prerelease
fi

printf 'dotnet: %s\n' "$(dotnet --version)"
printf 'roslyn-language-server: installed\n'
