#!/usr/bin/env bash
set -u

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

source "$repo_root/scripts/lib/platform.sh"
source "$repo_root/scripts/versions.env"

failures=0
warnings=0

ok() {
  printf 'OK    %s\n' "$1"
}

warn() {
  printf 'WARN  %s\n' "$1"
  warnings=$((warnings + 1))
}

fail() {
  printf 'FAIL  %s\n' "$1"
  failures=$((failures + 1))
}

check_command() {
  local command_name="$1"
  local label="${2:-$1}"

  if command -v "$command_name" >/dev/null 2>&1; then
    ok "$label"
  else
    fail "$label"
  fi
}

check_file() {
  local path="$1"
  local label="${2:-$1}"

  if [[ -f "$path" ]]; then
    ok "$label"
  else
    fail "$label"
  fi
}

check_enabled_service() {
  local service="$1"
  local label="${2:-$1}"

  if systemctl is-enabled --quiet "$service"; then
    ok "$label enabled"
  else
    fail "$label not enabled"
  fi
}

printf 'Platform\n'

if is_wsl; then
  ok "WSL2 detected"
else
  ok "Native Debian detected"
fi

if [[ -r /etc/debian_version ]]; then
  ok "Debian $(cat /etc/debian_version)"
else
  fail "Debian version unavailable"
fi

systemd_state="$(systemctl is-system-running 2>/dev/null || true)"

case "$systemd_state" in
  running)
    ok "systemd running"
    ;;
  degraded)
    warn "systemd degraded"
    ;;
  *)
    fail "systemd state: ${systemd_state:-unknown}"
    ;;
esac

if systemctl --user is-system-running --quiet; then
  ok "systemd user session running"
else
  warn "systemd user session not running"
fi

printf '\nShell and tools\n'

check_command bash
check_command git
check_command stow
check_command tmux
check_command fzf
check_command zoxide
check_command direnv
check_command rg "ripgrep"
check_command fdfind "fd"
check_command batcat "bat"
check_command eza
check_command tree-sitter "Tree-sitter CLI"
check_command stylua "StyLua"

printf '\nDotfiles\n'
check_file "$HOME/.bashrc" "Bash dotfile"
check_file "$HOME/.config/git/config" "Git config"
check_file "$HOME/.config/mise/config.toml" "mise config"
check_file "$HOME/.config/nvim/init.lua" "Neovim config"
check_file "$HOME/.config/tmux/tmux.conf" "tmux config"
check_file "$HOME/.pi/agent/settings.json" "Pi settings"
check_file "$HOME/.pi/agent/models-store.json" "Pi model store"

printf '\nCLI utilities\n'
check_command btop
check_command procs
check_command duf
check_command xh
check_command jq
check_command yq
check_command tldr
check_command glow
check_command shellcheck
check_command shfmt
check_command cmake
check_command ninja
check_command gdb
check_command strace
check_command git-lfs "Git LFS"
check_command lsof
check_command nc "netcat"
check_command rsync
check_command sqlite3
check_command tree

if declare -F command_not_found_handle >/dev/null 2>&1; then
  ok "command-not-found handler"
else
  fail "command-not-found handler"
fi

if ! is_wsl; then
  printf '\nDesktop\n'

  check_command sway
  check_command foot
  check_command waybar
  check_command fuzzel
  check_command mako
  check_command swaylock
  check_command swayidle
  check_command nm-applet "NetworkManager applet"
  check_command blueman-applet "Blueman applet"
  check_command wpctl "WirePlumber controls"
  check_command pavucontrol
  check_command thunar
  check_command grim
  check_command slurp
  check_command swappy
  check_command wl-copy "Wayland clipboard"
  check_command cliphist
  check_command brightnessctl
  check_command tuigreet

  check_enabled_service NetworkManager.service "NetworkManager"
  check_enabled_service bluetooth.service "Bluetooth"
  check_enabled_service tlp.service "TLP"
  check_enabled_service thermald.service "thermald"
  check_enabled_service greetd.service "greetd"
fi

printf '\nEditor\n'

check_command nvim "Neovim"

if command -v nvim >/dev/null 2>&1; then
  nvim_version="$(nvim --version | head -1)"

  if [[ "$nvim_version" == "NVIM v${NEOVIM_VERSION}" ]]; then
    ok "$nvim_version"
  else
    warn "Expected NVIM v${NEOVIM_VERSION}, found $nvim_version"
  fi

  if nvim --headless +qa >/dev/null 2>&1; then
    ok "Neovim configuration loads"
  else
    fail "Neovim configuration failed to load"
  fi
fi

printf '\nPython\n'

check_command uv
check_command ruff
check_command basedpyright

printf '\nTypeScript\n'

check_command mise
check_command node
check_command pnpm

printf '\n.NET\n'

check_command dotnet
check_command roslyn-language-server

printf '\nContainers\n'

check_command podman

if command -v podman >/dev/null 2>&1; then
  if [[ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" == "true" ]]; then
    ok "Podman rootless mode"
  else
    fail "Podman is not running rootless"
  fi
fi

printf '\nAI tooling\n'

check_command pi "Pi coding agent"

if command -v pi >/dev/null 2>&1; then
  pi_version="$(pi --version)"

  if [[ "$pi_version" == "$PI_VERSION" ]]; then
    ok "Pi ${pi_version}"
  else
    warn "Expected Pi ${PI_VERSION}, found ${pi_version}"
  fi
fi

printf '\nGitHub\n'

check_command gh "GitHub CLI"

if ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1 |
    grep -q "successfully authenticated"; then
  ok "GitHub SSH authentication"
else
  warn "GitHub SSH authentication unavailable"
fi

printf '\nSummary\n'
printf '%s failure(s), %s warning(s)\n' "$failures" "$warnings"

if (( failures > 0 )); then
  exit 1
fi
