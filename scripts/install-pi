#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
package="@earendil-works/pi-coding-agent"

source "$repo_root/scripts/lib/logging.sh"
source "$repo_root/scripts/versions.env"

version="$PI_VERSION"

if ! command -v pnpm >/dev/null 2>&1; then
  log_error "pnpm is required before installing Pi"
  exit 1
fi

installed="$(
  pnpm list --global --depth 0 --json 2>/dev/null |
    jq -r --arg package "$package" \
      '.[0].dependencies[$package].version // empty'
)"

if [[ "$installed" == "$version" ]]; then
  log_info "Pi already installed: $(pi --version)"
  exit 0
fi

log_info "Installing Pi ${version}"
pnpm add --global --ignore-scripts "${package}@${version}"

log_info "Pi: $(pi --version)"
