#!/usr/bin/env bash
set -Eeuo pipefail

if ! grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
  printf 'This script is intended for WSL.\n' >&2
  exit 1
fi

sudo tee /etc/wsl.conf >/dev/null <<EOF_WSL
[boot]
systemd=true

[user]
default=$USER

[interop]
enabled=true
appendWindowsPath=false
EOF_WSL

if [[ -f "$HOME/.bashrc" && ! -L "$HOME/.bashrc" ]]; then
  backup="$HOME/.bashrc.debian-default"

  if [[ ! -e "$backup" ]]; then
    mv "$HOME/.bashrc" "$backup"
    printf 'Saved existing .bashrc as %s\n' "$backup"
  else
    rm "$HOME/.bashrc"
    printf 'Removed existing .bashrc; backup already exists.\n'
  fi
fi

sudo systemctl disable --now getty@tty1.service 2>/dev/null || true
sudo systemctl reset-failed
sudo loginctl enable-linger "$USER"

printf '\nWSL preparation complete.\n'
printf 'From PowerShell, run:\n\n'
printf '  wsl --terminate %s\n\n' "${WSL_DISTRO_NAME:-<distribution-name>}"
printf 'Then reopen the distribution and run ./bootstrap.\n'
