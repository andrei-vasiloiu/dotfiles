#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
install_root="/opt/nvim-linux-x86_64"
archive="/tmp/nvim-linux-x86_64.tar.gz"

source "$repo_root/scripts/lib/logging.sh"
source "$repo_root/scripts/versions.env"
source "$repo_root/scripts/lib/platform.sh"

require_x86_64

version="$NEOVIM_VERSION"

if command -v nvim >/dev/null 2>&1; then
  current="$(nvim --version | head -1)"

  if [[ "$current" == "NVIM v${version}" ]]; then
    log_info "Neovim already installed: ${current}"
    exit 0
  fi
fi

log_info "Installing Neovim ${version}"

curl -fL \
  "https://github.com/neovim/neovim/releases/download/v${version}/nvim-linux-x86_64.tar.gz" \
  -o "$archive"

sudo rm -rf "$install_root"
sudo tar -C /opt -xzf "$archive"

sudo chmod 755 \
  "$install_root" \
  "$install_root/bin" \
  "$install_root/bin/nvim"

log_info "Neovim: $("$install_root/bin/nvim" --version | head -1)"
