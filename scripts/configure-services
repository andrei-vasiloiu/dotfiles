#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

source "$repo_root/scripts/lib/logging.sh"
source "$repo_root/scripts/lib/platform.sh"

require_debian

if is_wsl; then
  log_error "Native system services must not be configured under WSL"
  exit 1
fi

services=(
  NetworkManager.service
  bluetooth.service
  tlp.service
  thermald.service
)

for service in "${services[@]}"; do
  if ! systemctl list-unit-files "$service" --no-legend |
    grep -q "^${service}"; then
    log_error "Required service is unavailable: $service"
    exit 1
  fi

  log_info "Enabling $service"
  sudo systemctl enable "$service"
done

log_info "Native system services enabled"
