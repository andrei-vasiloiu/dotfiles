#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
archive="/tmp/tree-sitter-cli-linux-x64.zip"
extract_dir="/tmp/tree-sitter-cli"

source "$repo_root/scripts/lib/logging.sh"
source "$repo_root/scripts/versions.env"
source "$repo_root/scripts/lib/platform.sh"

require_x86_64

version="$TREE_SITTER_VERSION"

if command -v tree-sitter >/dev/null 2>&1; then
  current="$(tree-sitter --version | awk '{print $2}')"

  if [[ "$current" == "$version" ]]; then
    log_info "Tree-sitter already installed: ${current}"
    exit 0
  fi
fi

log_info "Installing Tree-sitter CLI ${version}"

curl -fL \
  "https://github.com/tree-sitter/tree-sitter/releases/download/v${version}/tree-sitter-cli-linux-x64.zip" \
  -o "$archive"

rm -rf "$extract_dir"
unzip -q "$archive" -d "$extract_dir"

sudo install \
  -m 0755 \
  "$extract_dir/tree-sitter" \
  /usr/local/bin/tree-sitter

log_info "tree-sitter: $(tree-sitter --version)"
