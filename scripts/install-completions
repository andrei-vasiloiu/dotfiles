#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
completion_dir="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"

# shellcheck disable=SC1091
source "$repo_root/scripts/lib/logging.sh"

mkdir -p "$completion_dir"

generate_completion() {
  local command_name="$1"
  local output_path="$2"
  local temporary_path
  shift 2

  if ! command -v "$command_name" >/dev/null 2>&1; then
    log_warn "Skipping completion for unavailable command: $command_name"
    return
  fi

  temporary_path="$(mktemp "${output_path}.tmp.XXXXXX")"

  log_info "Generating completion for $command_name"

  if "$@" > "$temporary_path"; then
    chmod 0644 "$temporary_path"
    mv -- "$temporary_path" "$output_path"
  else
    rm -f -- "$temporary_path"
    log_error "Failed to generate completion for $command_name"
    return 1
  fi
}

generate_completion gh \
  "$completion_dir/gh" \
  gh completion -s bash

generate_completion uv \
  "$completion_dir/uv" \
  uv generate-shell-completion bash

generate_completion uvx \
  "$completion_dir/uvx" \
  uvx --generate-shell-completion bash

generate_completion podman \
  "$completion_dir/podman" \
  podman completion bash

generate_completion pnpm \
  "$completion_dir/pnpm" \
  pnpm completion bash

log_info "CLI completions generated"
