#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

source "$repo_root/scripts/lib/logging.sh"
source "$repo_root/scripts/lib/platform.sh"

enable_error_trap
require_debian

log_step "Installing APT packages"
"$repo_root/scripts/install-apt"

log_step "Installing fonts"
"$repo_root/scripts/install-fonts"

log_step "Installing yq"
"$repo_root/scripts/install-yq"

log_step "Installing Python tooling"
"$repo_root/scripts/install-uv"

log_step "Installing Node.js and pnpm"
"$repo_root/scripts/install-mise"

log_step "Installing Pi"
"$repo_root/scripts/install-pi"

log_step "Installing .NET and Roslyn"
"$repo_root/scripts/install-dotnet"

log_step "Installing Tree-sitter CLI"
"$repo_root/scripts/install-tree-sitter"

log_step "Installing Neovim"
"$repo_root/scripts/install-neovim"

log_step "Applying dotfiles"
stow --dir="$repo_root" --target="$HOME" \
  bash \
  bat \
  direnv \
  git \
  less \
  mise \
  nvim \
  pi \
  ripgrep \
  ssh \
  sqlite \
  tealdeer \
  tmux

log_step "Running health check"
"$repo_root/scripts/health-check"
