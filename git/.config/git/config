[init]
    defaultBranch = develop

[fetch]
    prune = true

[pull]
    ff = only

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[include]
    path = ~/.config/local/gitconfig

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    syntax-theme = none
    hyperlinks = true

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram
    mnemonicPrefix = true

[pager]
    branch = false
    status = false

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[commit]
    verbose = true

[status]
    short = true
    branch = true
